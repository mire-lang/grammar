{
  "name": "Grammar",
  "scopeName": "source.grammar",
  "fileTypes": [
    "mire"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#namespaces"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.mire",
          "match": "//.*$"
        },
        {
          "name": "comment.block.mire",
          "begin": "/!",
          "end": "!/"
        }
      ]
    },
    "attributes": {
      "name": "meta.attribute.mire",
      "begin": "@\\[",
      "end": "\\]",
      "patterns": [
        {
          "name": "entity.name.function.attribute.mire",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.mire",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.mire",
              "match": "\\\\(?:[\\\\\"nrt0]|u\\{[0-9A-Fa-f]+\\})"
            },
            {
              "name": "variable.other.interpolation.mire",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.mire",
          "match": "(?<![A-Za-z_])[+-]?(?:\\d+\\.\\d*|\\.\\d+)(?:[eE][+-]?\\d+)?(?:f32|f64)?\\b"
        },
        {
          "name": "constant.numeric.integer.mire",
          "match": "(?<![A-Za-z_])[+-]?(?:0[xX][0-9A-Fa-f]+|0[bB][01]+|0[oO][0-7]+|\\d+)(?:i8|i16|i32|i64|i128|u8|u16|u32|u64|u128)?\\b"
        }
      ]
    },
    "keywords": {
      "name": "keyword.control.mire",
      "match": "\\b(?:as|at|break|continue|do|else|extends|find|for|if|impl|in|load!?|match|module|pub|return|set|struct|trait|unsafe|use!?|while)\\b|enum|where|override|pure"
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.mire",
          "match": "(?<![A-Za-z0-9_]):(?:anything|bool|char|f(?:32|64)|i(?:8|16|32|64|128)|ptr|str|u(?:8|16|32|64|128)|void)\\b"
        },
        {
          "name": "storage.type.mire",
          "match": "\\b(?:arr|map|vec|maybe|result)\\s*(?=\\[)"
        },
        {
          "name": "storage.modifier.mire",
          "match": "\\b(?:const|mut|extern|fn)\\b"
        }
      ]
    },
    "constants": {
      "name": "constant.language.mire",
      "match": "\\b(?:true|false|none|some|ok|err)\\b"
    },
    "declarations": {
      "patterns": [
        {
          "name": "entity.name.type.class.mire",
          "match": "\\b(?:struct|trait|enum)\\s+\\K[A-Z][A-Za-z0-9_]*"
        },
        {
          "name": "entity.name.function.mire",
          "match": "\\bfn\\s+\\K[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*"
        },
        {
          "name": "variable.other.mire",
          "match": "\\bset\\s+\\K[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "support.function.mire",
          "match": "\\b(?:dasu|ireru|len|str|print|panic|assert|assert_eq|exit)\\b(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.mire",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*(?=\\s*\\()"
        }
      ]
    },
    "namespaces": {
      "patterns": [
        {
          "name": "support.type.mire",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=::)"
        },
        {
          "name": "punctuation.accessor.mire",
          "match": "::|\\."
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.mire",
          "match": "(?:=>|->|==|!=|<=|>=|&&|\\|\\||\\+|-|\\*|/|%|<|>|=|!|\\?|\\||&)"
        },
        {
          "name": "punctuation.mire",
          "match": "[():\\[\\]{};,]"
        }
      ]
    }
  }
}